# RadioPX — variáveis lidas pelo backend em runtime.
# Copie para backend/.env e ajuste. O servidor falha no boot sem PostgreSQL.

# Server
SERVER_PORT=8080

# Database (obrigatório)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=radiopx
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_SSLMODE=disable

# JWT (fallback de dev com aviso no log se vazio)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
